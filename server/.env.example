# Database Configuration
# For MongoDB Atlas use the connection string from your cluster
MONGODB_URI=mongodb+srv://username:password@cluster-url.mongodb.net/etf-crypto?retryWrites=true&w=majority

# JWT Configuration
# Generate a strong secret key for production (e.g., openssl rand -base64 32)
JWT_SECRET=your-secret-key-change-this-in-production

# Server Configuration
# Port the server runs on
PORT=3333

# Node Environment
# Set to 'production' when deploying
NODE_ENV=development

# Frontend URL (for CORS)
# Update this to your frontend domain when deploying
FRONTEND_URL=http://localhost:5173
